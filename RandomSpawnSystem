--[[
    RandomSpawnSystem.lua

    Place this Script (Server Script) in ServerScriptService. 
    How to set up spawn points:
      Create a Folder named "SpawnPoints" inside Workspace.
      Inside it, place several Parts (can be invisible: Transparency = 1,
      CanCollide = false) scattered across the map. Part names don't matter.
      This script picks one of those Parts at random whenever a player
      joins or dies, and teleports the character there.
 
    Works for both the initial spawn and respawns after death.
]]
 
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
 
local CONFIG = {
    SpawnFolderName = "SpawnPoints",
    -- Extra height above the Part to avoid the character getting stuck in the ground
    SpawnHeightOffset = 3,
    -- If true, avoids reusing the same spawn point as last time (when more than 1 option exists)
    AvoidRepeatingLastSpawn = true,
}
 
local RandomSpawnSystem = {}
 
local spawnFolder = Workspace:FindFirstChild(CONFIG.SpawnFolderName)
if not spawnFolder then
    warn(("[RandomSpawnSystem] Folder '%s' not found in Workspace. Create it and add spawn Parts."):format(CONFIG.SpawnFolderName))
end
 
-- Stores the last spawn point used per player (to avoid repetition)
local lastSpawnByPlayer = {}
 
local function getSpawnPoints()
    if not spawnFolder then
        return {}
    end
 
    local points = {}
    for _, child in ipairs(spawnFolder:GetChildren()) do
        if child:IsA("BasePart") then
            table.insert(points, child)
        end
    end
    return points
end
 
local function pickRandomSpawnPoint(player)
    local points = getSpawnPoints()
 
    if #points == 0 then
        warn("[RandomSpawnSystem] No spawn points found.")
        return nil
    end
 
    if #points == 1 then
        return points[1]
    end
 
    if CONFIG.AvoidRepeatingLastSpawn then
        local lastPoint = lastSpawnByPlayer[player]
        local filtered = {}
        for _, point in ipairs(points) do
            if point ~= lastPoint then
                table.insert(filtered, point)
            end
        end
        if #filtered > 0 then
            points = filtered
        end
    end
 
    local chosen = points[math.random(1, #points)]
    lastSpawnByPlayer[player] = chosen
    return chosen
end
 
local function teleportCharacterTo(character, spawnPart)
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        rootPart = character:WaitForChild("HumanoidRootPart", 5)
    end
    if not rootPart then
        warn("[RandomSpawnSystem] HumanoidRootPart not found; could not teleport.")
        return
    end
 
    local targetCFrame = spawnPart.CFrame + Vector3.new(0, CONFIG.SpawnHeightOffset, 0)
    rootPart.CFrame = targetCFrame
end
 
local function onCharacterAdded(player, character)
    local spawnPart = pickRandomSpawnPoint(player)
    if spawnPart then
        teleportCharacterTo(character, spawnPart)
    end
end
 
local function onPlayerAdded(player)
    player.CharacterAdded:Connect(function(character)
        onCharacterAdded(player, character)
    end)
end
 
local function onPlayerRemoving(player)
    lastSpawnByPlayer[player] = nil
end
 
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
 
-- Covers players already in the game when this script runs (e.g. hot-reload during testing)
for _, player in ipairs(Players:GetPlayers()) do
    onPlayerAdded(player)
    if player.Character then
        onCharacterAdded(player, player.Character)
    end
end
 
return RandomSpawnSystem
